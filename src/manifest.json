{
    "manifest_version": 3,
    "name": "SenseUI",
    "short_name": "SenseUI",
    "version": "1.0.0",
    "description": "(Sprint 5) AI-powered visual design feedback for blind and visually impaired developers",
    "author": "Regina Castro",
    "homepage_url": "https://github.com/reginacas/sense-ui",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": ["activeTab", "storage", "scripting", "tabs", "sidePanel"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "side_panel": {
        "default_path": "index.html"
    },
    "action": {
        "default_popup": "index.html",
        "default_title": "SenseUI",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+S",
                "mac": "Command+Shift+S"
            },
            "description": "Open SenseUI (Popup Mode)"
        },
        "open_side_panel": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y",
                "mac": "Command+Shift+Y"
            },
            "description": "Open SenseUI Side Panel"
        },
        "close_side_panel": {
            "suggested_key": {
                "default": "Ctrl+Shift+X",
                "mac": "Command+Shift+X"
            },
            "description": "Close SenseUI Side Panel"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
